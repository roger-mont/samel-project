<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="WangYingTestTool.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:PresentationOptions="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options" xmlns:local="clr-namespace:WangYingTestTool" xmlns:effects="clr-namespace:WangYingTestTool.Effects" Title="WangYing Test Tool V0.0.1.1" Height="1000" Width="1700" WindowStartupLocation="CenterScreen" MaxWidth="1700" MaxHeight="1000" MinWidth="1700" MinHeight="1000" Loaded="Window_Loaded" Closed="Window_Closed">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <RadialGradientBrush x:Key="gradRadial">
        <GradientStop Offset="0" Color="#ffffffff" />
        <GradientStop Offset="1" Color="#00ffffff" />
      </RadialGradientBrush>
      <x:ArrayExtension x:Key="aColors" Type="{x:Type LinearGradientBrush}">
        <LinearGradientBrush PresentationOptions:Freeze="True" StartPoint="0,0" EndPoint="1,0" local:AttachedTitle.Title="Visible Spectrum">
          <GradientStop Color="White" Offset="0.01" />
          <GradientStop Color="#FF091BD3" Offset="0.1" />
          <GradientStop Color="#FF0452F7" Offset="0.20" />
          <GradientStop Color="#FF04C5F0" Offset="0.45" />
          <GradientStop Color="#FFA1FDA1" Offset="0.55" />
          <GradientStop Color="#ffff00" Offset="0.75" />
          <GradientStop Color="#FFFF8B00" Offset="0.85" />
          <GradientStop Color="#ff0000" Offset="0.95" />
          <GradientStop Color="#FFD508F5" Offset="1" />
        </LinearGradientBrush>
      </x:ArrayExtension>
      <VisualBrush x:Key="PaletteBrush">
        <VisualBrush.Visual>
          <Rectangle Width="256" Height="1" Fill="{Binding SelectedItem, ElementName=cbColors}" />
        </VisualBrush.Visual>
      </VisualBrush>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="#FFFFFFFF" SizeChanged="Grid_SizeChanged">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="238*" />
      <ColumnDefinition Width="185*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="auto" />
      <RowDefinition Height="1*" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Orientation="Horizontal" Grid.ColumnSpan="2">
      <TextBlock Text="Color schema:" Foreground="#FFFFFFFF" VerticalAlignment="Center" />
    </StackPanel>
    <local:HeatMap x:Name="cHeatMap" Grid.Row="1" ClipToBounds="True" Width="1600" Margin="96,0,-4,54" Height="900" Grid.ColumnSpan="2">
      <UIElement.Effect>
        <effects:HeatColorizer Palette="{StaticResource PaletteBrush}" />
      </UIElement.Effect>
    </local:HeatMap>
    <DataGrid Name="dataGrid" AutoGenerateColumns="True" Grid.Row="1" SelectionUnit="Cell" Visibility="Hidden" SelectionMode="Extended" HeadersVisibility="None" RowHeight="25" MinColumnWidth="25" Height="850" Width="1630" VerticalAlignment="Top" Background="#FFF7F3EE" BorderBrush="#FF252627" Grid.ColumnSpan="2" Margin="31,0">
      <DataGrid.RowStyle>
        <Style TargetType="{x:Type DataGridRow}">
          <Setter Property="Height" Value="25" />
          <Setter Property="FontSize" Value="10" />
        </Style>
      </DataGrid.RowStyle>
    </DataGrid>
    <Button Name="button" Content="2D HeatMap" Margin="749,880,32,27" Grid.Row="1" Click="button_Click" />
    <Button Name="Insert" Content="ValueMap" Margin="23,880,534,30" Grid.Row="1" Grid.Column="1" Click="Insert_Click" />
    <Button Name="export" Content="REC" Margin="380,879,258,31" Grid.Row="1" Background="#FFF11212" Grid.Column="1" Click="export_Click" />
    <ComboBox Name="cbColors" ItemsSource="{StaticResource aColors}" Height="30" Margin="416,0,269,32" VerticalAlignment="Bottom" Grid.Row="1" HorizontalContentAlignment="Stretch">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <StackPanel Orientation="Horizontal">
            <Rectangle Width="120" Height="10" Fill="{Binding}" />
            <TextBlock Margin="5,0,0,0" Text="{Binding (local:AttachedTitle.Title)}" />
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ComboBox>
    <Label Name="label" Content="" Margin="79,546,81,0" Grid.Row="1" VerticalAlignment="Top" Height="39" Background="#FFFFFFFF" Visibility="Hidden" Grid.ColumnSpan="2" />
    <Label Name="label_Copy" Content="" Margin="689,10,86,0" VerticalAlignment="Top" Height="634" Background="#FFFFFFFF" Grid.RowSpan="2" Visibility="Hidden" Grid.ColumnSpan="2" />
    <TextBox Name="textBox" Margin="263,880,374,32" Grid.Row="1" TextWrapping="Wrap" Text="3" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Column="1" />
    <Label Name="label1" Content="0" Margin="0,0,162,7" Grid.Row="1" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Center" VerticalAlignment="Bottom" Height="23" HorizontalAlignment="Right" Width="50" Visibility="Hidden" Grid.Column="1" />
    <TextBox Name="txt_filename" Margin="263,0,258,4" Grid.Row="1" TextWrapping="Wrap" Text="" Height="23" VerticalAlignment="Bottom" Grid.Column="1" />
    <Label Name="label2" Content="Name:" HorizontalAlignment="Left" Margin="206,0,0,4" Grid.Row="1" Width="52" Height="25" VerticalAlignment="Bottom" Grid.Column="1" />
    <Button Name="button1" Content="ZERO" Margin="499,882,142,32" Grid.Row="1" Grid.Column="1" Click="button1_Click" />
    <Button Name="button2" Content="Upload" Margin="613,882,31,32" Grid.Row="1" Grid.Column="1" Click="button2_Click" />
  </Grid>
</Window>