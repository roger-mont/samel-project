# 1. Identificador único do Leito / Maca
MACA_ID=MACA-UTI-01

# 2. Servidor Central do Hospital (Posto de Enfermagem)
CENTRAL_API_URL=http://192.168.1.100:8000
EDGE_API_TOKEN=samel_secret_token_123

# 3. Store-and-Forward (Gatilhos de Tempo e Volume)
SYNC_INTERVAL_SEC=60
SYNC_BATCH_SIZE=50

# 4. Retenção Local e Limites
RETENTION_DAYS=7
MAX_RETENTION_RECORDS=50000

# 5. Logs
LOG_LEVEL=INFO
